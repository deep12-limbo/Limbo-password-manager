{
    "manifest_version": 3,
    "name": "Password Manager",
    "version": "1.0.0",
    "description": "My password manager extension",

    "action": {
        "default_popup": "index.html"
    },

    "permissions": [
        "storage"
        , "identity"
    ],

    "host_permissions": [
        "<all_urls>"
    ],


"content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": ["inject.js"],
        "world": "MAIN",
        "run_at": "document_start"
    },
    {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_idle"
    }
],

    "background": {
        "service_worker": "service-worker.js"
    }
}